{
  "name": "nearpay-js",
  "version": "0.1.0",
  "private": true,
  "description": "NearPay widget loader (js.<domain>/v1/nearpay.js), @nearpay/js and @nearpay/react: mount the embedded checkout iframe and speak the versioned postMessage protocol.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.11.0 <23"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm coverage && pnpm build && pnpm e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@nearpay/spec": "0.1.4",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitest/coverage-v8": "2.1.9",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "zod": "4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
